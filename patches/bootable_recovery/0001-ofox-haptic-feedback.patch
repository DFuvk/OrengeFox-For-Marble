+int GUIAction::do_compose_haptic(std::string arg)
+{
+  if (vibrate_compose_pattern(arg.c_str()) != 0)
+    LOGINFO("[ofox-haptics] compose '%s' tidak didukung HAL\n", arg.c_str());
+  return 0;
