+
+int GUIAction::do_primitive_haptic(std::string arg)
+{
+  if (vibrate_primitive(atoi(arg.c_str())) != 0)
+    LOGINFO("[ofox-haptics] primitive %s tidak didukung HAL\n", arg.c_str());
+  return 0;
+}
