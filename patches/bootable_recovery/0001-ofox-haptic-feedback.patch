index 5dbbf72..ddf9bce 100644
--- a/minuitwrp/include/minuitwrp/minui.h
+++ b/minuitwrp/include/minuitwrp/minui.h
@@ -105,4 +105,14 @@ int res_scale_surface(gr_surface source, gr_surface* destination, float scale_w,
 
 int vibrate(int timeout_ms);
 
+// [ofox-haptics] Efek haptic AIDL (IVibrator::perform / compose).
+// Semua fungsi mengembalikan 0 kalau berhasil, negatif kalau tidak didukung
+// (pemanggil lalu kembali ke vibrate(durasi) biasa).
+// effect   : nilai android.hardware.vibrator.Effect (0=CLICK .. 5=HEAVY_CLICK)
+// strength : nilai EffectStrength (0=LIGHT, 1=MEDIUM, 2=STRONG)
+int haptic_effects_supported(void);          // 1 = didukung, 0 = tidak / HAL belum ada
+int vibrate_effect(int effect, int strength);
+int vibrate_primitive(int primitive);        // CompositePrimitive (1=CLICK .. 8=LOW_TICK)
+int vibrate_compose_pattern(const char* name); // "success", "error", "warning"
+
 #endif
 
